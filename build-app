#!/bin/sh
# Builds "Control Room.app", installs it in ~/Applications, and opens it.
# --no-open builds into build/ only (for checks), without touching the installed app.
set -e
cd "$(dirname "$0")"

swift build -c release --product ControlRoom
APP="build/Control Room.app"
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$(swift build -c release --show-bin-path)/ControlRoom" "$APP/Contents/MacOS/ControlRoom"
# Archivo, if it has been added to Resources/fonts.
cp Resources/fonts/*.ttf "$APP/Contents/Resources/" 2>/dev/null || true
# The neutral face. Redraw with: swift tools/make-icon.swift
cp icon/ControlRoom.icns "$APP/Contents/Resources/AppIconNeutral.icns"

cat > "$APP/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Control Room</string>
  <key>CFBundleDisplayName</key><string>Control Room</string>
  <key>CFBundleIdentifier</key><string>local.nina.controlroom</string>
  <key>CFBundleExecutable</key><string>ControlRoom</string>
  <key>CFBundleIconFile</key><string>AppIconNeutral</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleVersion</key><string>11</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSAppleEventsUsageDescription</key><string>Control Room types your quick replies into the Terminal window running that Claude Code session.</string>
</dict>
</plist>
PLIST

# Signed with Nina's Apple Development certificate when there is one, so macOS keeps
# Accessibility and Automation permissions across rebuilds. Anyone else gets an ad-hoc signature.
IDENTITY=$(security find-identity -v -p codesigning 2>/dev/null | awk '/Apple Development/ {print $2; exit}')
codesign --force --sign "${IDENTITY:--}" "$APP" >/dev/null
echo "Built $APP"

if [ "$1" != "--no-open" ]; then
  # Quit a running copy first so the new one can take the server port.
  osascript -e 'quit app "Control Room"' >/dev/null 2>&1 || true
  pkill -x ControlRoom 2>/dev/null || true
  sleep 0.5
  # Its permanent home: the login item points here, and Spotlight finds just this one.
  INSTALLED="$HOME/Applications/Control Room.app"
  mkdir -p "$HOME/Applications"
  rm -rf "$INSTALLED"
  ditto "$APP" "$INSTALLED"
  rm -rf "$APP"
  echo "Installed $INSTALLED"
  open "$INSTALLED"
fi
